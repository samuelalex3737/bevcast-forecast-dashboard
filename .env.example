# BevCast - LLM configuration (server-side only; keys never reach the browser).
# Set ONE provider key. The first key found is used, in this order: Groq, OpenAI, Gemini, Anthropic.
# With no key the AI Analyst still works using the built-in rule-based engine (clearly labelled).

# Groq (fast, free tier available) - default model: llama-3.3-70b-versatile
# GROQ_API_KEY=

# OpenAI - default model: gpt-4o-mini
# OPENAI_API_KEY=

# Google Gemini - default model: gemini-2.0-flash
# GEMINI_API_KEY=

# Anthropic - default model: claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq        # force a provider: groq | openai | gemini | anthropic
# LLM_MODEL=               # override the default model name for that provider
